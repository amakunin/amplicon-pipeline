[arrangement]
name = "Sanger_custom_barcode"
kit = "SciOps"

mask1_front = "CAAGCAGAAGACGGCATACGAGAT"
mask1_rear = "GAGATCGGTCTCGGCATTCCTGCTGAACCGCTCTTCCGATCT"
mask2_front = "CAAGCAGAAGACGGCATACGAGAT"
mask2_rear = "GAGATCGGTCTCGGCATTCCTGCTGAACCGCTCTTCCGATCT"

# Barcode sequences
barcode1_pattern = "SANGER-BCR%02i"
barcode2_pattern = "SANGER-BCR%02i"
first_index = 1
last_index = 96
rear_only_barcodes = true

## Scoring options
[scoring]
max_barcode_penalty = 0
barcode_end_proximity = 100
min_barcode_penalty_dist = 2
min_separation_only_dist = 100
flank_left_pad = 0
flank_right_pad = 0
front_barcode_window = 175
rear_barcode_window = 175
min_flank_score = 0.5
midstrand_flank_score = 0.95
