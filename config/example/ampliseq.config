// Passed to nf-core/ampliseq with -c; the driver will select local or lsf.
// Configure a supported container runtime before using either profile.
// For example, set docker.enabled = true in local or apptainer.enabled = true
// in lsf, and configure cache locations and mounts for your installation.

profiles {
    local {
        process.executor = 'local'
        process.cpus = 1
        process.resourceLimits = [memory: '1 GB']
    }

    lsf {
        process.executor = 'lsf'
        // Set process.queue and site-specific memory/submission options here.
    }
}
