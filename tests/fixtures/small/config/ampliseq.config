// Small-test adaptation of test_ampliseq_3_ont/ampliseq_lsf.config.
// Starting allocations only; measure usage on the first run.
profiles {
    lsf {
        docker.enabled = false
        singularity {
            enabled = true
            autoMounts = true
            // Add site-specific bind mounts in a local copy if required.
            runOptions = ''
            envWhitelist = 'REF_PATH'
            pullTimeout = '120 min'
        }

        executor.queueSize = 4

        process {
            executor = 'lsf'
            queue = 'long'
            cpus = 1
            memory = '2 GB'
            time = '2h'

            withLabel: process_single { memory = '1 GB' }
            withLabel: process_low { memory = '2 GB' }
            withLabel: process_medium { memory = '4 GB' }
            withLabel: process_high { memory = '8 GB' }

            withName: SAVONT_ASV {
                cpus = 2
                memory = '8 GB'
                time = '4h'
            }
            withName: VSEARCH_SINTAX {
                memory = '10 GB'
                time = '4h'
            }
        }
    }
}
